# Agricultural RAG & BERT — environment template
# Copy to .env and fill in only what you use. .env is gitignored.

# Optional: external LLM API keys (only needed if you enable hosted generation).
# The BERT classifiers and the local sentence-transformers RAG run WITHOUT any keys.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Optional: Streamlit / API server
PORT=8501
